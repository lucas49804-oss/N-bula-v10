        lb.Text = "NEBULA X ERRO: "..tostring(errRun).."  (toque para fechar)"
        lb.Parent = sg
        local bt = Instance.new("TextButton")
        bt.Size = UDim2.fromScale(1,1); bt.BackgroundTransparency = 1; bt.Text = ""; bt.Parent = lb
        bt.Activated:Connect(function() sg:Destroy() end)
    end)
