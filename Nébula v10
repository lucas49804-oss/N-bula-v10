local function getAimPart(char)
    local pn = S.aim.part
    if pn=="Cabeça" then return char:FindFirstChild("Head") or getRoot(char)
    elseif pn=="Peito" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or getRoot(char)
    else return getRoot(char) end
end

local function aimbot(vp, c)
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local bestD, bestPart = S.aim.fov, nil
    for _,p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if char and isEnemy(p) and isAlive(char) then
            local part = getAimPart(char)
            if part then
                local sp = c:WorldToViewportPoint(part.Position)
                if sp.Z>0 then
                    local d = (Vector2.new(sp.X,sp.Y)-center).Magnitude
                    if d < bestD and (not S.aim.wallCheck or visible(part,char)) then
                        bestD, bestPart = d, part
                    end
                end
            end
        end
    end
    if bestPart then
        local alpha = math.clamp(1 - S.aim.smooth/100, 0.01, 1)
        c.CFrame = c.CFrame:Lerp(CFrame.lookAt(c.CFrame.Position, bestPart.Position), alpha)
    end
end

---------------------------------------------------------------- HITBOX
local orig = {}
local function restore(part)
    local o = orig[part]
    if o and part.Parent then
        pcall(function()
            part.Size=o.Size; part.Transparency=o.Tr; part.CanCollide=o.CC
            part.Color=o.Col; part.Material=o.Mat; part.Massless=o.Ms
            part.CanQuery=o.CQ; part.CanTouch=o.CT
        end)
    end
    orig[part]=nil
end
local function targetParts(char)
    local list = {}
    local mode = S.hb.part
    if mode == "Cabeça" then
        local h = char:FindFirstChild("Head")
        if h and h:IsA("BasePart") then table.insert(list,h) end
    elseif mode == "Tudo" then
        for _,ch in ipairs(char:GetChildren()) do
            if ch:IsA("BasePart") then table.insert(list,ch) end
        end
    else
        local r = char:FindFirstChild("HumanoidRootPart") or getRoot(char)
        if r and r:IsA("BasePart") then table.insert(list,r) end
        local t = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if t and t:IsA("BasePart") and t ~= r then table.insert(list,t) end
    end
    return list
end
local function hitboxStep(c)
    if not S.hb.on and next(orig) == nil then return end
    local active = {}
    if S.hb.on then
        for _,p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            if char and isEnemy(p) and isAlive(char) then
                local root = getRoot(char)
                if root and (root.Position - c.CFrame.Position).Magnitude <= S.hb.range then
                    for _,part in ipairs(targetParts(char)) do active[part]=true end
                end
            end
        end
    end
    for part in pairs(orig) do
        if not part.Parent then orig[part]=nil
        elseif not active[part] then restore(part) end
    end
    local n = math.clamp(S.hb.size,1,HB_MAX)
    local sz = Vector3.new(n,n,n)
    local tr = math.clamp(S.hb.trans,0,10)/10
    local col = S.col.hb
    for part in pairs(active) do
        if not orig[part] then
            orig[part]={Size=part.Size,Tr=part.Transparency,CC=part.CanCollide,Col=part.Color,
                Mat=part.Material,Ms=part.Massless,CQ=part.CanQuery,CT=part.CanTouch}
        end
        pcall(function()
            if part.Size ~= sz then part.Size = sz end
            if part.Transparency ~= tr then part.Transparency = tr end
            if part.CanCollide then part.CanCollide = false end
            if not part.Massless then part.Massless = true end
            if not part.CanQuery then part.CanQuery = true end
            if not part.CanTouch then part.CanTouch = true end
            if part.Material ~= Enum.Material.Neon then part.Material = Enum.Material.Neon end
            if part.Color ~= col then part.Color = col end
        end)
    end
end

