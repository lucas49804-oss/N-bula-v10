        Size=UDim2.fromOffset(60,20),Text="cores v",TextColor3=Color3.fromRGB(170,170,200),
        Font=Enum.Font.GothamMedium,TextSize=11},hb)
    local sw = mk("Frame",{Size=UDim2.fromOffset(40,20),AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-8,.5,0),BorderSizePixel=0},hb)
    mk("UICorner",{CornerRadius=UDim.new(0,5)},sw)
    mk("UIStroke",{Color=WHITE,Thickness=1},sw)

    local pal = mk("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=BG,
        BorderSizePixel=0,Visible=false,LayoutOrder=2},cont)
    mk("UICorner",{CornerRadius=UDim.new(0,7)},pal)
    mk("UIPadding",{PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,4),PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,4)},pal)
    mk("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder},pal)
    local grid = mk("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=-1},pal)
    mk("UIGridLayout",{CellSize=UDim2.fromOffset(24,24),CellPadding=UDim2.fromOffset(3,3)},grid)

    local rgb = {r=0,g=0,b=0}
    local renders = {}
    local function readRGB()
        local c = S.col[key]
        rgb.r = math.floor(c.R*255+0.5)
        rgb.g = math.floor(c.G*255+0.5)
        rgb.b = math.floor(c.B*255+0.5)
    end
    local function sync()
        readRGB()
        sw.BackgroundColor3 = S.col[key]
        for _,r in ipairs(renders) do r() end
        if onChange then onChange() end
    end
    local function fromRGB()
        S.col[key] = Color3.fromRGB(rgb.r,rgb.g,rgb.b)
        sw.BackgroundColor3 = S.col[key]
        if onChange then onChange() end
    end
    local built = false
    local function build()
        if built then return end
        built = true
        readRGB()
        for _,pc in ipairs(PRESETS) do
            local b = mk("TextButton",{BackgroundColor3=pc,Text="",AutoButtonColor=false},grid)
            mk("UICorner",{CornerRadius=UDim.new(0,5)},b)
            b.Activated:Connect(function() S.col[key] = pc; sync() end)
        end
        table.insert(renders, sliderRow(pal,"Vermelho (R)",rgb,"r",0,255,1,fromRGB))
        table.insert(renders, sliderRow(pal,"Verde (G)",rgb,"g",0,255,1,fromRGB))
        table.insert(renders, sliderRow(pal,"Azul (B)",rgb,"b",0,255,1,fromRGB))
    end
    hb.Activated:Connect(function()
        if not pal.Visible then build() end
        pal.Visible = not pal.Visible
    end)
    sw.BackgroundColor3 = S.col[key]
end

