local function newFrame()
    return mk("Frame",{BorderSizePixel=0,BackgroundColor3=WHITE,Visible=false,AnchorPoint=Vector2.new(.5,.5)},layer)
end
local function newText(w)
    return mk("TextLabel",{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(w or 200,16),BackgroundTransparency=1,
        Font=Enum.Font.GothamBold,TextSize=12,TextStrokeTransparency=0,Visible=false},layer)
end
local function rect(f,x,y,w,h,col)
    f.Rotation=0
    f.Position=UDim2.fromOffset(x+w/2,y+h/2)
    f.Size=UDim2.fromOffset(w,h)
    f.BackgroundColor3=col
    f.Visible=true
end
local function line(f,a,b,th,col)
    local d=b-a
    f.Position=UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2)
    f.Size=UDim2.fromOffset(d.Magnitude,th)
    f.Rotation=math.deg(math.atan2(d.Y,d.X))
    f.BackgroundColor3=col
    f.Visible=true
end

local R15 = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
