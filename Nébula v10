local function updateESP(p, vp, c, now)
    local o = objs[p]
    if not o then track(p); o = objs[p]; if not o then return "hide" end end
    local char = p.Character
    if not (S.esp.on and char and isEnemy(p)) then return "hide" end
    local alive, hum = isAlive(char)
    if not alive then return "hide" end
    local root = getRoot(char)
    if not root then return "soft" end

    local dist = (root.Position - c.CFrame.Position).Magnitude
    if dist > S.esp.range then return "hide" end

    if now - o.visT > 0.1 then
        o.visT = now
        local ok, v = pcall(visible, root, char)
        if ok then o.vis = v end
    end
    local col = (S.esp.wall and not o.vis) and S.col.wall or S.col.esp

    local hipH = hum and hum.HipHeight or 2
    local top = c:WorldToViewportPoint(root.Position + Vector3.new(0,2.8,0))
    local bot = c:WorldToViewportPoint(root.Position - Vector3.new(0,math.max(hipH,2)+1,0))
    if top.Z <= 0 or bot.Z <= 0 then return "hide" end

    local h = math.max(bot.Y - top.Y, 14)
    local midY = (top.Y + bot.Y)/2
    local w = h*0.55
    local cx = (top.X+bot.X)/2
    local x1,y1,x2,y2 = cx-w/2, midY-h/2, cx+w/2, midY+h/2
    local t = h > 40 and 1.5 or 1
    local fs = math.clamp(math.floor(14 - dist/200),9,14)

    -- caixa
    if S.esp.box then
        if S.esp.boxStyle=="Cantos" then
            local L = math.max(math.min(w,h)*0.28,3)
            local segs = {
                {x1,y1,L,t},{x1,y1,t,L},{x2-L,y1,L,t},{x2-t,y1,t,L},
                {x1,y2-t,L,t},{x1,y2-L,t,L},{x2-L,y2-t,L,t},{x2-t,y2-L,t,L},
            }
            for i=1,8 do local s=segs[i]; rect(o.box[i],s[1],s[2],s[3],s[4],col) end
        else
            local segs = {{x1,y1,w,t},{x1,y2-t,w,t},{x1,y1,t,h},{x2-t,y1,t,h}}
            for i=1,4 do local s=segs[i]; rect(o.box[i],s[1],s[2],s[3],s[4],col) end
            for i=5,8 do o.box[i].Visible=false end
        end
    else
        for i=1,8 do o.box[i].Visible=false end
    end

    -- nome (em cima) e distância (embaixo)
    if S.esp.name then
        o.name.Text = p.DisplayName; o.name.TextSize = fs; o.name.TextColor3 = col
        o.name.Position = UDim2.fromOffset(cx, y1 - fs*0.5 - 3); o.name.Visible = true
    else o.name.Visible = false end
    if S.esp.dist then
        o.dist.Text = math.floor(dist).."m"; o.dist.TextSize = fs; o.dist.TextColor3 = col
        o.dist.Position = UDim2.fromOffset(cx, y2 + fs*0.5 + 3); o.dist.Visible = true
    else o.dist.Visible = false end

    -- vida (barra fina, arredondada, com animação suave)
    local hp, mx = readHealth(char, hum)
    if S.esp.health and hp then
        local fr = math.clamp(hp/mx,0,1)
        o.hpShown = o.hpShown + (fr - o.hpShown)*0.25
        local sf = math.clamp(o.hpShown,0,1)
        local bw = math.clamp(math.floor(h*0.03),2,4)
        local bh = h*0.9
        local by = midY - bh/2
        local left = (S.esp.healthSide=="Esquerda")
        local bx = left and (x1-bw-5) or (x2+5)
        rect(o.hbg,bx-1,by-1,bw+2,bh+2,Color3.fromRGB(10,10,10))
        local fh = math.max(bh*sf,2)
        rect(o.hfill,bx,by+bh-fh,bw,fh,Color3.fromHSV(sf*0.33,0.9,1))
        if S.esp.hpText then
            o.hp.Text = tostring(math.floor(hp+0.5)); o.hp.TextSize = math.max(fs-3,8); o.hp.TextColor3 = WHITE
            local tx = left and (bx-19) or (bx+bw+19)
            o.hp.Position = UDim2.fromOffset(tx, math.clamp(by+bh-fh, by, by+bh)); o.hp.Visible = true
        else o.hp.Visible = false end
    else
        o.hbg.Visible=false; o.hfill.Visible=false; o.hp.Visible=false
    end

    -- linha
    if S.esp.line then
        local oy = (S.esp.lineFrom=="Baixo") and vp.Y or ((S.esp.lineFrom=="Centro") and vp.Y/2 or 0)
        line(o.tracer,Vector2.new(vp.X/2,oy),Vector2.new(cx,y2),1.2,col)
    else o.tracer.Visible=false end

    -- esqueleto
    if S.esp.skel then
        local list = char:FindFirstChild("UpperTorso") and R15 or R6
        for i=1,14 do
            local pr, okk = list[i], false
            if pr then
                local a,b = char:FindFirstChild(pr[1]), char:FindFirstChild(pr[2])
                if a and b then
                    local pa = c:WorldToViewportPoint(a.Position)
                    local pb = c:WorldToViewportPoint(b.Position)
                    if pa.Z>0 and pb.Z>0 then
                        local f = o.skel[i]
                        if not f then f = newFrame(); o.skel[i] = f end
                        line(f,Vector2.new(pa.X,pa.Y),Vector2.new(pb.X,pb.Y),1.2,col); okk=true
                    end
                end
            end
            if not okk and o.skel[i] then o.skel[i].Visible=false end
        end
    else
        for _,f in pairs(o.skel) do f.Visible=false end
    end
    return nil
end

