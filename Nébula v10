local objs = {}
local function makeESP()
    local o = {box={}, skel={}, miss=0, vis=true, visT=0, hpShown=1}
    for i=1,8 do o.box[i]=newFrame() end
    -- barra de vida: fundo escuro arredondado + preenchimento com degradê
